@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-sans);
  --font-mono: var(--font-geist-mono);
  --font-heading: var(--font-sans);
  --font-bn: var(--font-bn);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
  /* Custom risk colors */
  --color-risk-green: oklch(0.55 0.18 145);
  --color-risk-amber: oklch(0.72 0.17 70);
  --color-risk-red: oklch(0.58 0.22 25);
  --color-risk-green-bg: oklch(0.95 0.04 145);
  --color-risk-amber-bg: oklch(0.97 0.06 70);
  --color-risk-red-bg: oklch(0.95 0.07 25);
  /* Official source accent */
  --color-info: oklch(0.45 0.08 250);
  --color-info-bg: oklch(0.94 0.02 240);
}

:root {
  --background: oklch(0.97 0.005 80);
  --foreground: oklch(0.18 0.03 250);
  --card: oklch(0.99 0.003 80);
  --card-foreground: oklch(0.18 0.03 250);
  --popover: oklch(0.99 0.003 80);
  --popover-foreground: oklch(0.18 0.03 250);
  --primary: oklch(0.58 0.18 155);
  --primary-foreground: oklch(0.99 0 0);
  --secondary: oklch(0.93 0.01 240);
  --secondary-foreground: oklch(0.18 0.03 250);
  --muted: oklch(0.94 0.02 240);
  --muted-foreground: oklch(0.45 0.02 250);
  --accent: oklch(0.93 0.01 240);
  --accent-foreground: oklch(0.18 0.03 250);
  --destructive: oklch(0.58 0.22 25);
  --border: oklch(0.88 0.01 80);
  --input: oklch(0.88 0.01 80);
  --ring: oklch(0.58 0.18 155);
  --chart-1: oklch(0.58 0.18 155);
  --chart-2: oklch(0.45 0.08 250);
  --chart-3: oklch(0.72 0.17 70);
  --chart-4: oklch(0.18 0.03 250);
  --chart-5: oklch(0.38 0.05 30);
  --radius: 0.625rem;
  --sidebar: oklch(0.99 0.003 80);
  --sidebar-foreground: oklch(0.18 0.03 250);
  --sidebar-primary: oklch(0.58 0.18 155);
  --sidebar-primary-foreground: oklch(0.99 0 0);
  --sidebar-accent: oklch(0.93 0.01 240);
  --sidebar-accent-foreground: oklch(0.18 0.03 250);
  --sidebar-border: oklch(0.88 0.01 80);
  --sidebar-ring: oklch(0.58 0.18 155);
}

.dark {
  --background: oklch(0.15 0.01 250);
  --foreground: oklch(0.94 0.01 80);
  --card: oklch(0.19 0.01 250);
  --card-foreground: oklch(0.94 0.01 80);
  --popover: oklch(0.19 0.01 250);
  --popover-foreground: oklch(0.94 0.01 80);
  --primary: oklch(0.62 0.17 155);
  --primary-foreground: oklch(0.15 0.01 250);
  --secondary: oklch(0.25 0.02 250);
  --secondary-foreground: oklch(0.94 0.01 80);
  --muted: oklch(0.22 0.02 250);
  --muted-foreground: oklch(0.7 0.01 240);
  --accent: oklch(0.25 0.02 250);
  --accent-foreground: oklch(0.94 0.01 80);
  --destructive: oklch(0.64 0.2 25);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.62 0.17 155);
  --chart-1: oklch(0.62 0.17 155);
  --chart-2: oklch(0.7 0.01 240);
  --chart-3: oklch(0.76 0.15 70);
  --chart-4: oklch(0.94 0.01 80);
  --chart-5: oklch(0.58 0.12 30);
  --sidebar: oklch(0.19 0.01 250);
  --sidebar-foreground: oklch(0.94 0.01 80);
  --sidebar-primary: oklch(0.62 0.17 155);
  --sidebar-primary-foreground: oklch(0.15 0.01 250);
  --sidebar-accent: oklch(0.25 0.02 250);
  --sidebar-accent-foreground: oklch(0.94 0.01 80);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.62 0.17 155);
}

/* Risk color classes */
.text-risk-green { color: var(--color-risk-green); }
.text-risk-amber { color: var(--color-risk-amber); }
.text-risk-red { color: var(--color-risk-red); }
.bg-risk-green { background-color: var(--color-risk-green-bg); }
.bg-risk-amber { background-color: var(--color-risk-amber-bg); }
.bg-risk-red { background-color: var(--color-risk-red-bg); }
.border-risk-green { border-color: var(--color-risk-green); }
.border-risk-amber { border-color: var(--color-risk-amber); }
.border-risk-red { border-color: var(--color-risk-red); }

/* Bengali font class */
.font-bn {
  font-family: var(--font-bn), "Noto Sans Bengali", sans-serif;
}

/* Large text accessibility mode */
.large-text {
  font-size: 1.125rem;
}
.large-text h1 { font-size: 2.5rem; line-height: 1.2; }
.large-text h2 { font-size: 2rem; line-height: 1.25; }
.large-text h3 { font-size: 1.5rem; line-height: 1.3; }
.large-text p, .large-text li, .large-text label { font-size: 1.25rem; line-height: 1.6; }
.large-text .text-sm { font-size: 1rem; }
.large-text .text-xs { font-size: 0.875rem; }
.large-text .text-base { font-size: 1.125rem; }
.large-text .text-lg { font-size: 1.375rem; }
.large-text .text-xl { font-size: 1.5rem; }
.large-text .text-2xl { font-size: 1.75rem; }
.large-text .text-3xl { font-size: 2.25rem; }
.large-text .text-4xl { font-size: 2.75rem; }
.large-text button, .large-text [role="button"] { font-size: 1.125rem; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
    scrollbar-gutter: stable;
  }
}